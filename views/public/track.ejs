<!DOCTYPE html>
<html>
  <head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />

    <title>Shikhar Transport</title>

    <!-- slider stylesheet -->
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css"
    />

    <!-- bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="/public/css/bootstrap.css" />
    <link rel="stylesheet" href="/assets/homeLoader.css" />

    <!-- fonts style -->
    <link
      href="https://fonts.googleapis.com/css?family=Open+Sans:400,700|Poppins:400,600,700&display=swap"
      rel="stylesheet"
    />

    <!-- Custom styles for this template -->
    <link href="/public/css/style.css" rel="stylesheet" />
    <!-- responsive style -->
    <link href="/public/css/responsive.css" rel="stylesheet" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      /* Prevent horizontal scrolling */
      body,
      html {
        overflow-x: hidden;
        width: 100%;
        color: white;
      }
      .aesthetic-input::placeholder {
        font-size: 0.85rem;
        color: #6c757d; /* Bootstrap's muted text color */
        font-style: italic;
        opacity: 0.8;
      }
    </style>
  </head>

  <body>
    <div class="hero_area">
      <!-- header section strats -->
      <header class="header_section">
        <div class="container-fluid">
          <nav class="navbar navbar-expand-lg custom_nav-container">
            <a class="navbar-brand" href="index.html">
              <span> Shikhar Transport </span>
            </a>

            <div class="navbar-collapse" id="">
              <div class="custom_menu-btn">
                <button onclick="openNav()">
                  <span class="s-1"> </span>
                  <span class="s-2"> </span>
                  <span class="s-3"> </span>
                </button>
              </div>
              <div id="myNav" class="overlay">
                <div class="overlay-content">
                  <a href="/">Home</a>

                  <button
                    onclick="Redirect()"
                    style="
                      all: unset;
                      cursor: pointer;
                      color: white;
                      font-size: 16px;
                    "
                    onmouseover="this.style.color='black'"
                    onmouseout="this.style.color='white'"
                  >
                    TRACKED BUSES
                  </button>
                </div>
              </div>
            </div>
          </nav>
        </div>
      </header>
      <!-- end header section -->
      <!-- slider section -->
      <section class="slider_section position-relative">
        <div class="slider_container">
          <div class="img-box" style="height: 600px !important">
            <img
              style="height: 500px !important"
              src="https://www.shikharschool.in//imgs/slider/2.jpg"
              alt=""
            />
          </div>
          <div class="detail_container">
            <div
              id="carouselExampleControls"
              class="carousel slide"
              data-ride="carousel"
            >
              <div class="carousel-inner p-2">
                <!-- Slide 1: Reliable Transport -->
                <div class="carousel-item active">
                  <div class="detail-box">
                    <h1>Smart Transport</h1>
                    <small>On-time. Hassle-free.</small><br />
                    <a href="/" style="text-decoration: none">Contact Us</a
                    ><br />
                    <small>powered by MohitSaini</small>
                  </div>
                </div>

                <!-- Slide 2: GPS Enabled -->
                <div class="carousel-item">
                  <div class="detail-box">
                    <h1>Live GPS</h1>
                    <small>Track in real-time.</small><br />
                    <a href="/" style="text-decoration: none">Contact Us</a
                    ><br />
                    <small>powered by MohitSaini</small>
                  </div>
                </div>

                <!-- Slide 3: Safety First -->
                <div class="carousel-item">
                  <div class="detail-box">
                    <h1>Safe Travel</h1>
                    <small>Secure & monitored.</small><br />
                    <a href="/" style="text-decoration: none">Contact Us</a
                    ><br />
                    <small>powered by MohitSaini</small>
                  </div>
                </div>
              </div>

              <a
                class="carousel-control-prev"
                href="#carouselExampleControls"
                role="button"
                data-slide="prev"
              >
                <span class="sr-only">Previous</span>
              </a>
              <a
                class="carousel-control-next"
                href="#carouselExampleControls"
                role="button"
                data-slide="next"
              >
                <span class="sr-only">Next</span>
              </a>
            </div>
          </div>
        </div>
      </section>
      <!-- end slider section -->
    </div>
    <!-- book section -->

    <!-- Loader -->
    <div class="loader-overlay" id="loader">
      <div class="loader-container">
        <img src="/public/bus.gif" alt="Loading..." class="bus-icon-img" />
        <div class="loader-text" id="loader-text">Loading, please wait...</div>
      </div>
    </div>

    <!-- map section -->

    <div class="container">
      <br />

      <% if (data && data.length > 0) { %> <% data.forEach((entry) => { const
      createdAt = new Date(entry.createdAt); const expiryDate = new
      Date(createdAt); expiryDate.setDate(createdAt.getDate() + 30); %>
      <div class="card mb-3">
        <div class="card-header"><%= entry.busId.busNumber %></div>
        <div class="card-body">
          <h5 class="card-title">Bus Route: (<%= entry.busId.route %>)</h5>
          <p class="card-text">
            <strong>Stop:</strong> <%= entry.stop.stopName %> <br />
            <strong>Morning Time:</strong> <%= entry.stop.morningTime %> <br />
            <strong>Evening Time:</strong> <%= entry.stop.eveningTime %> <br />
            <strong>Expiry Date:</strong> <%= expiryDate.toLocaleString() %>
            <br />
          </p>
          <div class="d-flex gap-2">
            <button
              class="btn btn-sm btn-warning toggle-btn"
              data-id="<%= entry._id %>"
              data-status="<%= !entry.isActive %>"
            >
              <%= entry.isActive ? "disabled" : "active" %>
            </button>

            <button
              class="btn btn-danger delete-btn"
              data-id="<%= entry._id %>"
            >
              Delete
            </button>
          </div>
        </div>
      </div>
      <% }); %> <% } else { %>
      <div class="alert alert-info text-center">
        You have not subscribed to any bus yet.
      </div>
      <% } %>
    </div>

    <section class="map_section">
      <!-- map section -->
      <div class="map_container">
        <div class="map-responsive">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d19968.3436634647!2d78.45650732517238!3d29.309972479809193!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390bc83931ace96b%3A0x4ea74aaa43769550!2sShikhar%20Shishu%20Sadan!5e1!3m2!1sen!2sin!4v1755253827565!5m2!1sen!2sin"
            width="600"
            height="300"
            frameborder="0"
            style="border: 0; width: 100%; height: 100%"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <!-- end map section -->
    </section>

    <!-- end map section -->

    <!-- footer section -->
    <footer class="container-fluid footer_section">
      <p>
        Copyright &copy; 2025 All Rights Reserved. Developed by
        <a href="https://assocom.onrender.com/home"> Mohit Saini </a>
      </p>
    </footer>
    <!-- footer section -->

    <script>
      function openNav() {
        document.getElementById("myNav").classList.toggle("menu_width");
        document
          .querySelector(".custom_menu-btn")
          .classList.toggle("menu_btn-style");
      }

      function Redirect() {
        const fcmToken = localStorage.getItem("fcmToken");
        if (fcmToken) {
          window.location.href = `/track/${fcmToken}`;
        } else {
          alert("You have not Tracked Any Bus Yet");
        }
      }
    </script>

    <script src="/public/js/jquery-3.4.1.min.js"></script>
    <script src="/public/js/bootstrap.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/public/js/custom.js"></script>

    <script src="/custom/public.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".toggle-btn").forEach((buttonElement) => {
          buttonElement.addEventListener("click", () => {
            const id = buttonElement.dataset.id;
            const status = buttonElement.dataset.status === "true";
            const originalText = buttonElement.textContent;
            buttonElement.textContent = "changing...";

            document.getElementById("loader-text").textContent =
              "changing........";
            document.getElementById("loader").style.display = "flex";

            fetch(`/toggleFCM/${id}`, {
              method: "PATCH",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({ isActive: status }),
            })
              .then((res) => res.json())
              .then((data) => {
                if (data.success) {
                  buttonElement.textContent = status ? "disabled" : "active";
                  buttonElement.dataset.status = (!status).toString();

                  document.getElementById("loader-text").textContent =
                    "Changed";
                  document.getElementById("loader").style.display = "none";
                } else {
                  a;

                  document.getElementById("loader-text").textContent =
                    data.message ||
                    "Something went wrong while updating status.";
                  setTimeout(() => {
                    document.getElementById("loader").style.display = "none";
                  }, 2000);
                  buttonElement.textContent = originalText;
                }
              })
              .catch((err) => {
                console.error("Toggle error:", err);
                alert("Network error while toggling status.");

                document.getElementById("loader-text").textContent =
                  "Network error while toggling status.";
                setTimeout(() => {
                  document.getElementById("loader").style.display = "none";
                }, 2000);
                buttonElement.textContent = originalText;
              });
          });
        });

        document.querySelectorAll(".delete-btn").forEach((buttonElement) => {
          buttonElement.addEventListener("click", () => {
            const id = buttonElement.dataset.id;

            if (confirm("Are you sure you want to delete this tracking?")) {
              const originalText = buttonElement.textContent;
              buttonElement.textContent = "deleting...";
              buttonElement.disabled = true;

              fetch(`/deleteFCM/${id}`, {
                method: "DELETE",
              })
                .then((res) => res.json())
                .then((data) => {
                  if (data.success) {
                    const card = buttonElement.closest(".card");
                    if (card) card.remove();
                  } else {
                    alert(
                      data.message || "Something went wrong while deleting."
                    );
                    buttonElement.textContent = originalText;
                    buttonElement.disabled = false;
                  }
                })
                .catch((err) => {
                  console.error("Delete error:", err);
                  alert("Network error while deleting tracking.");
                  buttonElement.textContent = originalText;
                  buttonElement.disabled = false;
                });
            }
          });
        });

        document.getElementById("loader-text").textContent = "Loading...";
        document.getElementById("loader").style.display = "none";
      });
    </script>
  </body>
</html>
