<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- slider stylesheet -->
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css"
    />

    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css"
    />
    <!-- bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="/public/css/bootstrap.css" />
    <link rel="stylesheet" href="/assets/homeLoader.css" />

    <!-- fonts style -->
    <link
      href="https://fonts.googleapis.com/css?family=Open+Sans:400,700|Poppins:400,600,700&display=swap"
      rel="stylesheet"
    />
 

    <!-- Custom styles for this template -->
    <link href="/public/css/style.css" rel="stylesheet" />
    <!-- responsive style -->
    <link href="/public/css/responsive.css" rel="stylesheet" />

    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />


    
    <style>
      /* Custom media query for mobile devices */
      @media (max-width: 576px) {
        .embed-responsive {
          height: 300px; /* Adjust the height for mobile screens */
        }
      }
      #map {
        width: 100%;
        height: 400px;
      }
    </style>

<style>
  .timeline {
position: relative;
padding-left: 20px;
}
</style>

    <title>Tracking <%=bus.busNumber %></title>
  </head>
  <body>
    <div class="hero_area">
      <!-- header section strats -->
      <header class="header_section">
        <div class="container-fluid">
          <nav class="navbar navbar-expand-lg custom_nav-container">
  
            

            <div class="navbar-collapse" id="">
              <div class="custom_menu-btn">
                <button onclick="openNav()">
                  <span class="s-1"> </span>
                  <span class="s-2"> </span>
                  <span class="s-3"> </span>
                </button>
              </div>
              <div id="myNav" class="overlay">
                <div class="overlay-content">
                  <a href="/">Home</a>
                  <button
                  onclick="Redirect()"
                  style="
                    all: unset;
                    cursor: pointer;
                    color: white;
                    font-size: 16px;
                  "
                  onmouseover="this.style.color='black'"
                  onmouseout="this.style.color='white'"
                >
                  TRACKED BUSES
                </button>
                </div>
              </div>
            </div>
          </nav>
        </div>
      </header>

      
      <!-- end header section -->
      <!-- slider section -->
      <section class="slider_section position-relative">
        
        <div class="slider_container">
          <div class="img-box">

            
            <div class="embed-responsive embed-responsive-16by9">

              
              <iframe
                src="/locationBus/<%=bus._id  %>"
                class="embed-responsive-item"
                allowfullscreen
                loading="lazy"
              >
              </iframe>

              
            </div>
          </div>
          <div class="detail_container">
            <div
              id="carouselExampleControls"
              class="carousel slide"
              data-ride="carousel"
            >
              <div class="carousel-inner p-2">
                <!-- Slide 1: Driver Details -->
                <div class="carousel-item active">
                  <div class="detail-box text-white p-4">
                    <h2 class="mb-3">Driver Details</h2>
                    <div class="row">
                      <div class="col-md-6">
                        <strong>Name:</strong> <%=bus.driver.name %>
                      </div>
                      <br />
                      <div class="col-md-6">
                        <strong>Phone:</strong> <%=bus.driver.phone %>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Slide 2: Conductor Details -->
                <div class="carousel-item">
                  <div class="detail-box text-white p-4">
                    <h2 class="mb-3">Helper Details</h2>
                    <div class="row">
                      <div class="col-md-6">
                        <strong>Name:</strong> <%=bus.conductor.name %>
                      </div>
                      <br />
                      <div class="col-md-6">
                        <strong>Phone:</strong> <%=bus.conductor.phone %>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Slide 3: Bus Details -->
                <div class="carousel-item">
                  <div class="detail-box text-white p-4">
                    <h2 class="mb-3">Bus Details</h2>
                    <div class="row">
                      <div class="col-md-6">
                        <strong>Bus Number:</strong><%=bus.busNumber %>
                      </div>
                      <div class="col-md-6">
                        <strong>Route:</strong> <%=bus.route %>
                      </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <a
                class="carousel-control-prev"
                href="#carouselExampleControls"
                role="button"
                data-slide="prev"
              >
                <span class="sr-only">Previous</span>
              </a>
              <a
                class="carousel-control-next"
                href="#carouselExampleControls"
                role="button"
                data-slide="next"
              >
                <span class="sr-only">Next</span>
              </a>
            </div>
          </div>
        </div>
      </section>
      <!-- end slider section -->
    </div>
    <!-- book section -->
    <section class="book_section">
      <div class="form_container">
        <form>
          <div class="row g-3 align-items-center">
            <div class="col-auto">

              <p>
           
                
                <br />
                <strong>Powered by:</strong> Mohit Saini
                <br />
                <em>© 2025 Bus Tracking System. All rights reserved. Licensed under XYZ License.</em>
              </p>
              
            </div>
       
            
          </div>
          <br />
 
          
        </form>
      </div>
      <div class="img-box text-center">
        <img
          src="/public/bus.gif"
          alt="Book Car"
          class="img-fluid"
          style="max-width: 160px; height: auto"
        />
      </div>
    </section>

    <div class="container">

      <h3>Demo Show (typical path)</h3>
      <div class="row">
        <div class="col-12 col-md-6 mb-3">
          <iframe  style="height: 400px" width="100%" src="/routingMachine/?busId=<%=bus._id  %>"></iframe>
        </div>
        <div class="col-12 col-md-6">

          <h4>Stops</h4>
          <div class="timeline">
            <% if (bus.routeStops && bus.routeStops.length > 0) { %>
              <% bus.routeStops.forEach((stop, index) => { %>
                <div class="d-flex">
                  <div class="d-flex flex-column align-items-center me-3">
                    <% if (index !== 0) { %>
                      <div class="border-start border-2 h-100" style="width: 2px;"></div>
                    <% } %>
              
                    
                    <% if (index !== bus.routeStops.length - 1) { %>
                      <div class="border-start border-2 h-100" style="width: 2px;"></div>
                    <% } %>
                  </div>
                  <div class="mb-3">
                    <p class="mb-0 fw-bold text-capitalize">
                      ➤ <%= stop.stopName %>
                      <span class="text-muted">(Morning: <%= stop.morningTime %>, Evening: <%= stop.eveningTime %>)</span>
                    </p>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <p>No stops available for this bus.</p>
            <% } %>
          </div>

          <p>
            You can view a demo of the bus movements and the daily route it follows in the neighboring section.
          </p>
          
        </div>
        
      </div>
    </div>

    
    <section class="map_section">
      <!-- map section -->
      <div class="map_container">
        <div class="map-responsive">
          <iframe
src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d19968.3436634647!2d78.45650732517238!3d29.309972479809193!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390bc83931ace96b%3A0x4ea74aaa43769550!2sShikhar%20Shishu%20Sadan!5e1!3m2!1sen!2sin!4v1755253827565!5m2!1sen!2sin"
            width="600"
            height="300"
            frameborder="0"
            style="border: 0; width: 100%; height: 100%"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <!-- end map section -->
    </section>

    <!-- end map section -->

    <!-- footer section -->
    <footer class="container-fluid footer_section">
      <p>
        Copyright &copy; 2025 All Rights Reserved. Developed by
        <a href="https://assocom.onrender.com/home"> Mohit Saini </a>
      </p>
    </footer>
    <!-- footer section -->
    <div class="loader-overlay" id="loader">
      <div class="loader-container">
        <img src="/public/bus.gif" alt="Loading..." class="bus-icon-img" />
        <div class="loader-text" id="loader-text">Loading, please wait...</div>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>

    <script src="/public/js/jquery-3.4.1.min.js"></script>
    <script src="/public/js/bootstrap.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
   
    
    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
