    <style>
      #stopMap {
        position: relative;
        height: 300px;
        background: #eef6ff;
        border: 1px solid #ccc;
        border-radius: 10px;
        overflow: hidden;
      }

      /* Markers */
      .map-marker {
        position: absolute;
        transform: translate(-50%, -100%);
        z-index: 2;
        cursor: pointer;
        transition: transform 0.3s ease;
      }

      /* SVG pin */
      .map-marker svg {
        width: 28px;
        height: 28px;
        fill: red;
        transition: 0.3s ease;
      }

      /* Active */
      .map-marker.active svg {
        fill: #007bff;
        transform: scale(1.2);
      }

      /* Labels */

      .stop-label {
        font-size: 12px;
        text-align: center;
        margin-top: 4px;
        color: #333;
      }

      .stop-number {
        background-color: #007bff;
        color: white;
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 12px;
        display: inline-block;
        margin-bottom: 2px;
      }
    </style>
