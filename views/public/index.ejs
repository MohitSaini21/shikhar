    <script>
      document
        .getElementById("complaintForm")
        .addEventListener("submit", async function (e) {
          e.preventDefault();

          const complaintType = document.getElementById("type").value;
          const incidentTime = document.getElementById("incidentTime").value;
          const busNumber = document.getElementById("numberBus").value.trim();
          const description = document
            .getElementById("description")
            .value.trim();
          console.log(complaintType, incidentTime, busNumber);

          if (!complaintType || !incidentTime || !busNumber) {
            alert("Please fill all required fields.");
            return;
          }

          const data = {
            complaintType,
            incidentTime,
            busNumber,
            description,
          };

          try {
            const res = await fetch("/complaints", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(data),
            });

            const result = await res.json();
            if (res.ok) {
              alert("✅ Complaint submitted successfully.");
              this.reset();
            } else {
              alert("❌ Error: " + (result.message || "Failed to submit."));
            }
          } catch (error) {
            console.error("Error:", error);
            alert("❌ Network or server error.");
          }
        });
    </script>
